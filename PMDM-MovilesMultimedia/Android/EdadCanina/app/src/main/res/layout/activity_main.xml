<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/perro"
        android:adjustViewBounds="true"
        />

    <TextView
        android:id="@+id/texto_pregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Qué edad tienes?"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="24sp"
        android:textColor="@color/verde"
        />
    <EditText
        android:id="@+id/edit_edad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:ems="10"
        android:hint="Introduce tu edad"
        android:gravity="center"
        android:inputType="number"

        />

    <Button
        android:id="@+id/boton_calcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24sp"
        android:layout_marginVertical="16dp"
        android:backgroundTint="@color/verde"
        android:text="Calcular"
        android:textSize="20sp"
        />
    <TextView
        android:id="@+id/texto_respuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Si fueras un perro, tendrías... 47 años!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="24sp"
        android:gravity="center"
        android:textColor="@color/black"
        />
</LinearLayout>