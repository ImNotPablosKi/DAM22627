QWidget {

    background-color: white;

}


QLabel {

    color: blue;
    font-weight: bold;

}

QLineEdit {

    color: blue;
    border: 1px solid blue;
    border-radius: 5px;

}

QPushButton {

    border-radius: 5px;
    padding: 5px;

}

QPushButton#btnAceptar {

    border: 3px solid red;
    color: red;

}

QPushButton#btnCancelar {

    border: 3px solid green;
    color: green;

}