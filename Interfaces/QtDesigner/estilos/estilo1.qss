QLabel {

    font-family: 'Times New Roman', Times, serif;
    font-size: 14px;
    font-style: italic;
    font-weight: bold;

}

QPushButton {

    background-color: salmon;

}

QTextEdit {

    border-width: 5px;
    border-style: solid;
    border-color: green;
    margin: 20px;
    padding: 20px;
    border-radius: 15px;

}

QLineEdit {

    min-width: 20px;
    max-width: 20px;
    min-height: 30px;
    max-height: 30px;

}

.QWidget {

    background-color: green;

}